# Railway service: web
# Paste into the service Variables raw editor.
RAILWAY_DOCKERFILE_PATH=/deploy/web.Dockerfile
PORT=3000

DATABASE_URL=${{Postgres.DATABASE_URL}}
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret
AUTH_TRUST_HOST=true

POPULATION_PROVIDER=local
POPULATION_SERVICE_URL=http://${{population-service.RAILWAY_PRIVATE_DOMAIN}}:${{population-service.PORT}}
POPULATION_SERVICE_AUTH_TOKEN=${{population-service.POPULATION_SERVICE_AUTH_TOKEN}}
POPULATION_SERVICE_TIMEOUT_MS=120000
