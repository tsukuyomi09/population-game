# Railway service: population
# Paste into the service Variables raw editor, then replace the auth token.
RAILWAY_DOCKERFILE_PATH=/deploy/population.Dockerfile
RAILWAY_RUN_UID=0
RAILWAY_HEALTHCHECK_TIMEOUT_SEC=900
PORT=8001

POPULATION_RASTER_PATH=/data/population/rasters
POPULATION_TILE_INDEX_PATH=/data/population/tile-index
POPULATION_TILE_SIZE=512

POPULATION_SERVICE_HOST=0.0.0.0
POPULATION_SERVICE_PORT=8001
POPULATION_SERVICE_WORKERS=2
POPULATION_SERVICE_QUEUE_SIZE=8
POPULATION_SERVICE_RETRY_AFTER_SECONDS=1
POPULATION_SERVICE_MAX_REQUEST_BYTES=1000000
POPULATION_SERVICE_AUTH_TOKEN=replace-with-a-long-random-token
