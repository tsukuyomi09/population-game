# Host binding for the Next.js container. Keep loopback when using a reverse proxy.
WORLDRAWING_BIND_ADDRESS=127.0.0.1
WORLDRAWING_HTTP_PORT=3000

# Absolute host directory containing compatible WorldPop GeoTIFF files.
POPULATION_RASTER_HOST_PATH=/srv/worldrawing/population

# Shared by Next.js and the private population service. Generate a long random value.
POPULATION_SERVICE_AUTH_TOKEN=replace-with-a-long-random-token

# Next.js reaches the service by its private Compose DNS name.
POPULATION_SERVICE_URL=http://population:8001
POPULATION_SERVICE_TIMEOUT_MS=120000

# Population engine and bounded admission settings.
POPULATION_TILE_SIZE=512
POPULATION_SERVICE_PROCESS_WORKERS=4
POPULATION_SERVICE_QUEUE_SIZE=50
POPULATION_SERVICE_RETRY_AFTER_SECONDS=1
POPULATION_SERVICE_MAX_REQUEST_BYTES=1000000
