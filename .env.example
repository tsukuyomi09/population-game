# Defaults to WorldPop when omitted. Supported values: worldpop, local.
POPULATION_PROVIDER=worldpop

# Required when POPULATION_PROVIDER=local. Compatible country rasters are discovered here.
POPULATION_RASTER_PATH=./data/population
POPULATION_PYTHON_PATH=./.venv-population/bin/python

# Optional local-provider tile preaggregation settings.
POPULATION_TILE_SIZE=512
POPULATION_TILE_INDEX_PATH=./artifacts/population/tile-index

# Private Python population service. It is not called by Next.js yet.
POPULATION_SERVICE_HOST=127.0.0.1
POPULATION_SERVICE_PORT=8001
POPULATION_SERVICE_WORKERS=2
POPULATION_SERVICE_QUEUE_SIZE=8
POPULATION_SERVICE_RETRY_AFTER_SECONDS=1
POPULATION_SERVICE_MAX_REQUEST_BYTES=1000000
