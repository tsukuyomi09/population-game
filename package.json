{
  "name": "worldrawing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "node scripts/dev.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "db:migrate": "node-pg-migrate up",
    "db:migrate:down": "node-pg-migrate down",
    "db:migrate:create": "node-pg-migrate create --migration-file-language sql",
    "load:population": "node scripts/load-test-population.mjs",
    "prod:local": "node scripts/production-local.mjs up",
    "prod:local:down": "node scripts/production-local.mjs down",
    "test:account": "tsc --project features/account/tsconfig.test.json && node --test artifacts/account/tests/features/account/account.test.js",
    "test:profile": "tsc --project features/account/tsconfig.profile.test.json && node --test artifacts/account/profile-tests/features/account/profile.test.js",
    "test:ranked-rating": "tsc --project features/rating/server/tsconfig.test.json && node --test artifacts/rating/tests/features/rating/server/current-ratings.test.js artifacts/rating/tests/features/rating/server/ranked-duel-finalization.test.js",
    "test:game-identity": "tsc --project features/game/tsconfig.test.json && node --test artifacts/game/identity-tests/features/game/runtime-player.test.js",
    "test:game-runtime": "tsc --project features/game/tsconfig.test.json && node --test artifacts/game/identity-tests/features/game/server/runtime-game.test.js artifacts/game/identity-tests/features/game/server/runtime-submission.test.js",
    "test:direct-duel": "tsc --project features/game/tsconfig.test.json && node --test artifacts/game/identity-tests/features/game/server/direct-duel-service.test.js",
    "test:matchmaking": "tsc --project features/game/tsconfig.test.json && node --test artifacts/game/identity-tests/features/game/server/matchmaking-service.test.js",
    "test:single-persistence": "tsc --project features/game/server/tsconfig.test.json && node --test artifacts/game/single-persistence-tests/features/game/server/single-game-service.test.js",
    "test:single-leaderboard": "tsc --project features/leaderboard/server/tsconfig.test.json && node --test artifacts/leaderboard/tests/features/leaderboard/server/single-leaderboard.test.js",
    "test:ranked-leaderboard": "tsc --project features/leaderboard/server/tsconfig.test.json && node --test artifacts/leaderboard/tests/features/leaderboard/server/ranked-leaderboard.test.js",
    "test:population-adapter": "tsc --project features/population/server/tsconfig.test.json && node --test artifacts/population/adapter-tests/features/population/server/population-service-client.test.js"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.10.0",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "node-pg-migrate": "^9.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2"
  }
}
